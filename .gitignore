__pycache__/
*.pyc
.DS_Store

# full ANDES DEBUG tails from failed scoring runs: large, kept on the machine that ran them
*.debug.log

# what a solver run or the RSI loop leaves behind while it works: a run's sandbox (kept for --resume until the run
# finishes), half-written files from an interrupted write, the candidate checker's scratch folders, the updater's
# sandboxes, the loop's lock
sandbox/
*.tmp
.checker_*/
.updater_sandbox_*/
loop.lock

# the RSI loops are their own git repository (harness-experiments)
rsi_loops/
# what move_after_reorg.sh puts aside on a machine whose ignored files did not move with a pull
_leftovers_from_reorg/
