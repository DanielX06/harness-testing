 },
 "defs": {
  "Vcmd": "Vset - mq*(Qm - Q0)",
  "Eint": "Min(Max(kpv*(Vcmd - Vm) + xv, Emin), Emax)",
  "ph": "delta - theta",
  "Pd": "Eint*V*sin(ph)/XL",
  "Qd": "(Eint*V*cos(ph) - V**2)/XL"
 },
 "states": {
  "Pm": {
   "rhs": "(Pd - Pm)/TPf",
   "init": "P0"
  },
  "Qm": {
