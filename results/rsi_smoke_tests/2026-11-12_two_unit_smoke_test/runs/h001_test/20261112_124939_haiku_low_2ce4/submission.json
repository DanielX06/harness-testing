  "a": 1.7017774426211416
 },
 "defs": {
  "Vcmd": "Vset + mq*(Q0 - Qm)",
  "Eint": "Min(Max(kpv*(Vcmd - Vm) + xv, 0), 1.5)",
  "Pe": "V*Eint*sin(dl - theta)/XL",
  "Qe": "(V*Eint*cos(dl - theta) - V**2)/XL + a*(V - V0)"
 },
 "states": {
