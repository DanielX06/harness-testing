  "Pe": "V*Eint*sin(delta - theta)/XL",
  "Qe": "V*(Eint*cos(delta - theta) - V)/XL + bq*(V*V - V0*V0)"
 },
 "states": {
  "delta": {
   "rhs": "w0*mp*(P0 - Pm)",
   "init": "theta0 + atan2(P0*XL/V0, (Q0*XL + V0**2)/V0)"
