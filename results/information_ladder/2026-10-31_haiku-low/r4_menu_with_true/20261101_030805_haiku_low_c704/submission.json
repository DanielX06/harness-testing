  "rf": 0.0,
  "w0": 376.99111843077515
 },
 "defs": {
  "vd": "V*cos(delta - theta)",
  "vq": "-V*sin(delta - theta)",
  "vr": "Vset + n*(Q0 - Qf)",
  "Idref": "Kpv*(vr - vd) + xvd",
  "Iqref": "Kpv*(0 - vq) + xvq",
  "det": "rf**2 + xf**2",
  "Id": "(rf*(ud - vd) + xf*(uq - vq))/det",
  "Iq": "(-xf*(ud - vd) + rf*(uq - vq))/det",
  "udref": "Kpi*(Idref - Id) + xid + vd + rf*Id - xf*Iq",
  "uqref": "Kpi*(Iqref - Iq) + xiq + vq + rf*Iq + xf*Id",
  "Pe": "vd*Id + vq*Iq",
  "Qe": "-vd*Iq + vq*Id"
 },
 "states": {
  "Pf": {
   "rhs": "(Pe - Pf)/Tf",
   "init": "P0"
  },
  "Qf": {
   "rhs": "(Qe - Qf)/Tf",
   "init": "Q0"
  },
  "delta": {
   "rhs": "w0*m*(P0 - Pf)",
   "init": "theta0"
  },
  "xvd": {
   "rhs": "Kiv*(vr - vd)",
   "init": "P0/V0"
  },
  "xvq": {
   "rhs": "Kiv*(0 - vq)",
   "init": "-Q0/V0"
  },
  "xid": {
   "rhs": "Kii*(Idref - Id)",
   "init": "0"
  },
  "xiq": {
   "rhs": "Kii*(Iqref - Iq)",
   "init": "0"
  },
  "ud": {
   "rhs": "(udref - ud)/Te",
   "init": "V0 + rf*P0/V0 + xf*Q0/V0"
  },
  "uq": {
   "rhs": "(uqref - uq)/Te",
   "init": "-rf*Q0/V0 + xf*P0/V0"
  }
 },
 "outputs": {
  "P": "Pe",
  "Q": "Qe"
 }
}