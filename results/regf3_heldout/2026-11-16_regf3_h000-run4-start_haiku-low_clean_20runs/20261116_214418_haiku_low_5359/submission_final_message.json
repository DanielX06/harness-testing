{
 "params": {
  "XL": 0.3,
  "mp": 0.05886,
  "mq": 26.70326,
  "kiv": 2.2736,
  "kpv": 0.04797,
  "TPf": 0.005,
  "TVf": 0.06137,
  "TQf": 0.01075
 },
 "defs": {
  "Vc": "Vset+mq*(Q0-Qm)",
  "Eint": "Min(Max(xv+kpv*(Vc-Vm),0.0),1.25)",
  "ang": "dl-theta",
  "Pout": "V*Eint*sin(ang)/XL",
  "Qout": "V*(Eint*cos(ang)-V)/XL"
 },
 "states": {
  "Pm": {
   "rhs": "(Pout-Pm)/TPf",
   "init": "P0"
  },
  "Qm": {
   "rhs": "(Qout-Qm)/TQf",
   "init": "Q0"
  },
  "Vm": {
   "rhs": "(V-Vm)/TVf",
   "init": "V0"
  },
  "xv": {
   "rhs": "kiv*(Vc-Vm)",
   "init": "sqrt((XL*P0/V0)**2+(V0+XL*Q0/V0)**2)"
  },
  "dl": {
   "rhs": "2*pi*60*mp*(P0-Pm)",
   "init": "atan2(XL*P0/V0,V0+XL*Q0/V0)+theta0"
  }
 },
 "outputs": {
  "P": "Pout",
  "Q": "Qout"
 }
}