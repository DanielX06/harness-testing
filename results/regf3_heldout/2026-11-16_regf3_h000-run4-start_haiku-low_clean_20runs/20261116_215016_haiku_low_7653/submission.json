{
 "params": {
  "XL": 0.39999999999999974,
  "mp": 0.05416150659563938,
  "mq": 29.999999999754678,
  "kpv": 0.05564242579176584,
  "kiv": 31.62199758978602,
  "TPf": 0.002000000007055461,
  "TQf": 0.002534971427056651,
  "TVf": 0.09999999999959039,
  "w0": 376.99111843077515
 },
 "defs": {
  "Vcmd": "Vset + mq*(Q0 - Qm)",
  "Eint": "kpv*(Vcmd - Vm) + xv",
  "Pe": "V*Eint*sin(delta - theta)/XL",
  "Qe": "V*(Eint*cos(delta - theta) - V)/XL"
 },
 "states": {
  "Pm": {
   "rhs": "(Pe - Pm)/TPf",
   "init": "P0"
  },
  "Qm": {
   "rhs": "(Qe - Qm)/TQf",
   "init": "Q0"
  },
  "Vm": {
   "rhs": "(V - Vm)/TVf",
   "init": "V0"
  },
  "xv": {
   "rhs": "kiv*(Vcmd - Vm)",
   "init": "sqrt((V0 + XL*Q0/V0)**2 + (XL*P0/V0)**2)"
  },
  "delta": {
   "rhs": "w0*mp*(P0 - Pm)",
   "init": "theta0 + atan2(XL*P0/V0, V0 + XL*Q0/V0)"
  }
 },
 "outputs": {
  "P": "Pe",
  "Q": "Qe"
 }
}