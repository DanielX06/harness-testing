  "params": {
    "XL": 1.0,
    "mp": 0.06,
    "TPf": 0.01,
    "TQ": 0.5,
    "kqv": 0.0,
    "w0": 376.99111843077515
  },
  "defs": {
    "dl": "delta - theta",
    "Pe": "V*V0*sin(dl)/XL"
  },
  "states": {
    "delta": {
      "rhs": "w0*mp*(P0-Pm)",
      "init": "theta0 + atan2((P0*XL/V0**2), sqrt(1-(P0*XL/V0**2)**2))"
    },
    "Pm": {
      "rhs": "(Pe-Pm)/TPf",
      "init": "P0"
    },
    "Qm": {
      "rhs": "(Q0 + kqv*(V-V0) - Qm)/TQ",
      "init": "Q0"
    }
  },
  "outputs": {
    "P": "Pe",
    "Q": "Qm"
  }
}
