    "mq": 623.323579135356,
    "w0": 376.99111843077515
  },
  "defs": {
    "Vcmd": "Vset + mq*(Q0 - Qm)",
    "Ei": "xv + kpv*(Vcmd - Vm)",
    "dl": "delta - theta",
    "Pe": "V*(XL*Ei*sin(dl))/XL**2",
    "Qe": "V*(XL*(Ei*cos(dl) - V))/XL**2",
    "Pcmd": "P0 - dw/mp"
  },
  "states": {
    "delta": {
      "rhs": "w0*dw",
      "init": "theta0 + atan2(XL*P0/V0, V0 + XL*Q0/V0)"
    },
    "dw": {
      "rhs": "(Pcmd - Pe - D*dw)/(2*H)",
      "init": "0"
    },
    "xv": {
      "rhs": "kiv*(Vcmd - Vm)",
      "init": "sqrt((V0 + XL*Q0/V0)**2 + (XL*P0/V0)**2) - kpv*(V0 - V0)"
    },
    "Qm": {
      "rhs": "(Qe - Qm)/0.02",
      "init": "Q0"
    },
    "Vm": {
      "rhs": "(V - Vm)/0.02",
      "init": "V0"
    }
  },
  "outputs": {
    "P": "Pe",
    "Q": "Qe"
  }
}
