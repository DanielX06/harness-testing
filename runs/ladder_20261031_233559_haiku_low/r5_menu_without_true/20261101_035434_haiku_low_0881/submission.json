{
 "params": {
  "Tf": 1.9595920208988455e-07,
  "m": 0.059394932302280504,
  "n": 0.025794551708145104,
  "Kpv": 0.6837357713630479,
  "Kiv": 1.179881640492552,
  "w0": 376.99111843077515
 },
 "defs": {
  "vd": "V*cos(delta - theta)",
  "vq": "-V*sin(delta - theta)",
  "vr": "Vset + n*(Q0 - Qf)",
  "Idref": "Kpv*(vr - vd) + xvd",
  "Iqref": "Kpv*(0 - vq) + xvq",
  "Id": "Idref",
  "Iq": "Iqref",
  "Pe": "vd*Id + vq*Iq",
  "Qe": "-vd*Iq + vq*Id"
 },
 "states": {
  "Pf": {
   "rhs": "(Pe - Pf)/Tf",
   "init": "P0"
  },
  "Qf": {
   "rhs": "(Qe - Qf)/Tf",
   "init": "Q0"
  },
  "delta": {
   "rhs": "w0*m*(P0 - Pf)",
   "init": "theta0"
  },
  "xvd": {
   "rhs": "Kiv*(vr - vd)",
   "init": "P0/V0"
  },
  "xvq": {
   "rhs": "Kiv*(0 - vq)",
   "init": "-Q0/V0"
  }
 },
 "outputs": {
  "P": "Pe",
  "Q": "Qe"
 }
}